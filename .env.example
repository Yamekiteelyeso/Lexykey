# Copia este archivo a .env (NO lo subas a Git) y rellena los valores.
LEXY_ENV=production
# Generar con: python -c "import secrets;print(secrets.token_urlsafe(48))"
LEXY_SECRET_KEY=CAMBIA_ESTO_POR_UN_VALOR_ALEATORIO_DE_48_CARACTERES_O_MAS
LEXY_KEY_PEPPER=CAMBIA_ESTO_POR_OTRO_VALOR_ALEATORIO_DE_48_CARACTERES_O_MAS
# Contraseña temporal del primer acceso (no puede ser "admin"). Se cambia en el primer login.
LEXY_BOOTSTRAP_PASSWORD=UnaContrasenaTemporalLarga#2026
LEXY_DB_PATH=/var/lib/lexyhub/lexyhub.db
# Detrás de un proxy HTTPS (Nginx/Caddy/Render) activa esto:
LEXY_TRUST_PROXY=1
# Verificación de cuenta Roblox (obligatorio "profile" en producción)
LEXY_ROBLOX_VERIFY=profile
LEXY_LICENSE_TYPES=Standard,Premium,VIP
LEXY_SESSION_HOURS=8
LEXY_IDLE_MINUTES=60
